# ─── InfiniteAg — Environment Variables Template ─────────────────────────────
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is listed in .gitignore.
#
# When deploying to Vercel, add these as Environment Variables in the
# Vercel dashboard (Settings → Environment Variables) instead of using
# a .env file on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Resend — transactional email API
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives quote/assessment form submissions
CONTACT_TO_EMAIL=your@email.com

# The "From" address used in outbound emails (must be a verified Resend domain)
CONTACT_FROM_EMAIL=noreply@yourdomain.com
